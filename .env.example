# Copy to .env and adjust. Never commit .env.
TS_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TS_SECRET_KEY=
# Unset -> local SQLite at data/terrasentinel-dev.db. Docker Compose overrides this.
# TS_DATABASE_URL=postgresql+psycopg://terrasentinel:terrasentinel@localhost:5432/terrasentinel
TS_REDIS_URL=redis://localhost:6379/0
TS_LOG_LEVEL=INFO
TS_LOG_JSON=false
TS_ALLOW_REGISTRATION=true
